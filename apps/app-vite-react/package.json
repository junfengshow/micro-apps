{
  "name": "@micro-apps/app-vite-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host localhost",
    "typecheck": "tsc --noEmit",
    "format": "prettier --config .prettierrc --ignore-path .prettierignore --write .",
    "format:check": "prettier --config .prettierrc --ignore-path .prettierignore --check ."
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.2",
    "prettier": "^3.3.3",
    "typescript": "^5.9.0",
    "vite": "^6.4.5",
    "vite-plugin-qiankun": "^1.0.15"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
