{
  "name": "@micro-apps/app-react-source",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "react:install": "node scripts/react.mjs install",
    "react:build": "node scripts/react.mjs build",
    "react:setup": "npm run react:install && npm run react:build",
    "dev": "vite --host localhost --force",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host localhost",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --config .prettierrc --ignore-path .prettierignore --write .",
    "format:check": "prettier --config .prettierrc --ignore-path .prettierignore --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.2",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.0",
    "vite": "^6.4.5",
    "vite-plugin-qiankun": "^1.0.15",
    "yarn": "1.22.22"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
